{
  "name": "storybook-carbon-theme",
  "version": "0.0.0",
  "description": "Carbon Design System light and dark themes for the Storybook UI, docs pages and stories",
  "keywords": [
    "storybook-addon",
    "carbon",
    "carbon-design-system",
    "theme",
    "dark-mode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devadula-nandan/carbon-theme-storybook-addon.git"
  },
  "license": "MIT",
  "author": "nandan <devadula.nandan@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "manager.js",
    "preview.js"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build-storybook": "storybook build",
    "build:watch": "tsup --watch src",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "start": "pnpm build && run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@carbon/colors": "^11.60.0",
    "@carbon/element-styles": "^0.4.0",
    "@carbon/feature-flags": "^1.10.0",
    "@carbon/grid": "^11.64.0",
    "@carbon/layout": "^11.61.0",
    "@carbon/motion": "^11.54.0",
    "@carbon/styles": "^1.117.0",
    "@carbon/themes": "^11.83.0",
    "@carbon/type": "^11.69.0",
    "@eslint/js": "^9.36.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/icons": "^2.0.0",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^20",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild-sass-plugin": "^3.6.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.97.3",
    "storybook": "^10.6.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.0.5"
  },
  "peerDependencies": {
    "@storybook/addon-docs": "^10.0.0",
    "storybook": "^10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.tsx",
      "src/index.ts"
    ]
  },
  "storybook": {
    "displayName": "Carbon theme",
    "supportedFrameworks": [
      "web-components",
      "react"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
